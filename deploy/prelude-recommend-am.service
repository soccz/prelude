[Unit]
Description=prelude recommend radar pre-open 08:50 KST (SHADOW telegram)
After=network.target

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/home/soccz/22tb/prelude
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_recommend_am.sh
TimeoutStartSec=600
StandardOutput=append:/home/soccz/22tb/prelude/output/cron_recommend_am.log
StandardError=append:/home/soccz/22tb/prelude/output/cron_recommend_am.log
