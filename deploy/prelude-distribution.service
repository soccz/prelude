[Unit]
Description=prelude distribution daily 09:05 KST (ACTIVE-only telegram)
After=network.target

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/home/soccz/22tb/prelude
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_run_distribution.sh
TimeoutStartSec=600
StandardOutput=append:/home/soccz/22tb/prelude/output/cron_dist.log
StandardError=append:/home/soccz/22tb/prelude/output/cron_dist.log
