[Unit]
Description=prelude distribution paper/shadow ledger close-out daily 09:30 KST
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/home/soccz/22tb/prelude
OnFailure=prelude-failure-alert@%n.service

[Service]
Type=oneshot
User=soccz
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/home/soccz/22tb/prelude
Environment=TZ=Asia/Seoul
ExecStart=/home/soccz/22tb/prelude/deploy/run_pipeline_stage.sh distribution-close /bin/bash /home/soccz/22tb/prelude/scripts/daily_close_distribution.sh
# Includes data collection, five 96-bar ledger evaluations and report rebuilds.
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
