[Unit]
Description=prelude distribution paper/shadow ledger close-out daily 09:30 KST
After=network.target

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/home/soccz/22tb/prelude
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_close_distribution.sh
TimeoutStartSec=600
StandardOutput=append:/home/soccz/22tb/prelude/output/cron_close.log
StandardError=append:/home/soccz/22tb/prelude/output/cron_close.log
