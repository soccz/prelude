#!/usr/bin/env bash
# 정상 git push 전 변경 Python lint + 전수 스위트 게이트 — 우발적인
# 깨진 push를 로컬에서 차단한다 (2026-07-29 재발방지 라운드).
#
# 활성화: git config core.hooksPath deploy/git-hooks
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"
PYTHON_BIN="$REPO/venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
    echo "[pre-push] venv 없음 — 게이트를 평가할 수 없어 push 차단" >&2
    exit 1
fi
HEAD_SHA="$(git rev-parse HEAD)"

RUFF_BIN="${PRELUDE_RUFF_BIN:-}"
if [ -z "$RUFF_BIN" ]; then
    RUFF_BIN="$(command -v ruff || true)"
fi
if [ -z "$RUFF_BIN" ] || [ ! -x "$RUFF_BIN" ]; then
    echo "[pre-push] ruff 없음 — lint 게이트를 평가할 수 없어 push 차단" >&2
    exit 1
fi

LOG_DIR="${TMPDIR:-/home/soccz/22tb/tmp}"
mkdir -p "$LOG_DIR"
RUFF_LOG="$LOG_DIR/prelude-prepush-ruff.log"
LOG_FILE="$LOG_DIR/prelude-prepush-pytest.log"
CHECKOUT_ROOT="$(mktemp -d "$LOG_DIR/prelude-prepush-worktree.XXXXXX")"
CHECKOUT="$CHECKOUT_ROOT/tree"
cleanup() {
    git worktree remove --force "$CHECKOUT" >/dev/null 2>&1 || true
    rmdir "$CHECKOUT_ROOT" >/dev/null 2>&1 || true
}
trap cleanup EXIT

if ! git worktree add --detach --quiet "$CHECKOUT" "$HEAD_SHA"; then
    echo "[pre-push] push HEAD 임시 worktree 생성 실패 — push 차단" >&2
    exit 1
fi

# The repository intentionally ignores the local virtualenv and live candle
# databases.  A detached worktree therefore needs an executable-environment
# link plus inert, non-SQLite provenance sentinels.  Tests may hash these two
# canonical paths, but any attempt to query them as production databases must
# still fail (tests that need rows create their own tmp_path SQLite files).
if [ ! -e "$CHECKOUT/venv" ]; then
    if ! ln -s "$REPO/venv" "$CHECKOUT/venv"; then
        echo "[pre-push] 임시 worktree venv 연결 실패 — push 차단" >&2
        exit 1
    fi
fi
mkdir -p "$CHECKOUT/data"
for provenance_db in upbit_d1.db binance_d1.db; do
    if [ ! -e "$CHECKOUT/data/$provenance_db" ]; then
        printf 'pre-push hermetic provenance sentinel\n' \
            > "$CHECKOUT/data/$provenance_db"
    fi
done
ZERO_SHA="0000000000000000000000000000000000000000"
declare -A PUSHED_PYTHON_FILES=()

# stdin: <local ref> <local sha> <remote ref> <remote sha>, ref마다 한 줄.
# 삭제된 파일은 제외하고, remote에 실제로 추가되는 Python diff만 lint한다.
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "${local_ref:-}" ] || [ "$local_sha" = "$ZERO_SHA" ]; then
        continue
    fi
    if [ "$local_sha" != "$HEAD_SHA" ]; then
        echo "[pre-push] 현재 HEAD가 아닌 ref push는 검증 대상과 불일치해 차단: $local_ref" >&2
        exit 1
    fi
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        base_sha="$(git hash-object -t tree /dev/null)"
    else
        base_sha="$remote_sha"
    fi
    if ! git cat-file -e "${base_sha}^{tree}" 2>/dev/null; then
        echo "[pre-push] remote base 객체가 로컬에 없어 diff를 검증할 수 없음: $base_sha" >&2
        exit 1
    fi
    python_diff=""
    if ! python_diff=$(git diff --name-only --diff-filter=ACMR \
        "$base_sha" "$local_sha" -- "*.py"); then
        echo "[pre-push] push 대상 Python diff 계산 실패 — push 차단" >&2
        exit 1
    fi
    while IFS= read -r path; do
        if [ -n "$path" ] && [ -f "$CHECKOUT/$path" ]; then
            PUSHED_PYTHON_FILES["$path"]=1
        fi
    done <<<"$python_diff"
done

if [ "${#PUSHED_PYTHON_FILES[@]}" -gt 0 ]; then
    mapfile -t python_files < <(
        printf '%s\n' "${!PUSHED_PYTHON_FILES[@]}" | sort
    )
    echo "[pre-push] 변경 Python ${#python_files[@]}개 Ruff 검사 중" >&2
    if (
        cd "$CHECKOUT"
        "$RUFF_BIN" check "${python_files[@]}"
    ) >"$RUFF_LOG" 2>&1; then
        echo "[pre-push] Ruff 통과" >&2
    else
        echo "[pre-push] Ruff 실패 — push 차단" >&2
        tail -30 "$RUFF_LOG" >&2
        exit 1
    fi
fi

echo "[pre-push] 전수 pytest 게이트 실행 중 (~3분, 로그: $LOG_FILE)" >&2
if (
    cd "$CHECKOUT"
    PRELUDE_FORBID_TELEGRAM=1 \
        "$PYTHON_BIN" -m pytest -q -p no:cacheprovider
) >"$LOG_FILE" 2>&1; then
    tail -1 "$LOG_FILE" >&2
    echo "[pre-push] 게이트 통과 — push 진행" >&2
else
    echo "[pre-push] 전수 스위트 실패 — push 차단" >&2
    tail -15 "$LOG_FILE" >&2
    exit 1
fi
