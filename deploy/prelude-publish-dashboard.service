[Unit]
Description=prelude dashboard publish (build JSON + git push to soccz.github.io)
Wants=network-online.target
After=network-online.target prelude-close.service prelude-preopen-close.service
RequiresMountsFor=/home/soccz/22tb/prelude /home/soccz/22tb/soccz.github.io
OnFailure=prelude-failure-alert@%n.service

[Service]
Type=oneshot
User=soccz
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/home/soccz/22tb/prelude
Environment=TZ=Asia/Seoul
ExecStart=/home/soccz/22tb/prelude/deploy/run_pipeline_stage.sh publish /bin/bash /home/soccz/22tb/prelude/scripts/publish_dashboard.sh
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
