[Unit]
Description=prelude recommend radar open 09:05 KST (SHADOW telegram + ledger)
After=network.target

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/home/soccz/22tb/prelude
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_recommend_open.sh
TimeoutStartSec=600
StandardOutput=append:/home/soccz/22tb/prelude/output/cron_recommend_open.log
StandardError=append:/home/soccz/22tb/prelude/output/cron_recommend_open.log
