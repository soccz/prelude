[Unit]
Description=prelude pre-open trigger daily 08:50 KST (ACTIVE-only telegram)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/home/soccz/22tb/prelude
OnFailure=prelude-failure-alert@%n.service

[Service]
Type=oneshot
User=soccz
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/home/soccz/22tb/prelude
Environment=TZ=Asia/Seoul
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_run_preopen.sh
TimeoutStartSec=1200
StandardOutput=journal
StandardError=journal
