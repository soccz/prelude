[Unit]
Description=prelude recommend SHADOW ledger close-out daily 09:35 KST (realize prior-day open rows)
After=network.target

[Service]
Type=oneshot
User=soccz
WorkingDirectory=/home/soccz/22tb/prelude
ExecStart=/bin/bash /home/soccz/22tb/prelude/scripts/daily_recommend_close.sh
TimeoutStartSec=600
StandardOutput=append:/home/soccz/22tb/prelude/output/cron_recommend_close.log
StandardError=append:/home/soccz/22tb/prelude/output/cron_recommend_close.log
